# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# LLM Model selection
LLM_MODEL=gpt-4o-mini

# Embedding model (used for RAG vector store)
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI Whisper model for speech-to-text
STT_MODEL=whisper-1

# OpenAI TTS model and voice
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Path to the FAISS index on disk (will be created on first run)
FAISS_INDEX_PATH=faiss_index

# Path to knowledge-base data directory
DATA_DIR=data

# FastAPI server settings
HOST=0.0.0.0
PORT=8000
